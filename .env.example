# Backend environment variables. NO real secrets here; copy to .env (git-ignored) or set in your
# IDE run configuration / hosting dashboard. Spring Boot reads these from the process environment.
# Every variable is optional locally (APP_JWT_SECRET falls back to a random per-run secret): the defaults below match docker-compose.yml.

# --- docker-compose.yml (Postgres container) ---
POSTGRES_DB=chzzk
POSTGRES_USER=chzzk
POSTGRES_PASSWORD=chzzk

# --- Backend (Spring Boot) ---
# HTTP port. Railway injects PORT automatically.
PORT=8080
# JDBC connection to PostgreSQL.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/chzzk
SPRING_DATASOURCE_USERNAME=chzzk
SPRING_DATASOURCE_PASSWORD=chzzk
# Comma-separated browser origins allowed to call the API (the frontend's URL).
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
# Directory where uploaded videos are stored. On Railway, point this at an attached Volume mount path.
APP_STORAGE_DIR=./uploads
# Maximum upload size (Spring size string, e.g. 500MB).
APP_MAX_UPLOAD_SIZE=500MB

# --- Live broadcasting (step 2) ---
# Seconds a broadcast stays LIVE after the broadcaster's connection drops, before it is marked ENDED.
# A phone that reconnects within this time keeps the same broadcast.
APP_LIVE_GRACE_SECONDS=15
# STUN servers (comma-separated) browsers use to discover their public address for WebRTC.
APP_WEBRTC_STUN_URLS=stun:stun.l.google.com:19302
# Optional TURN relay, needed on networks where direct peer-to-peer fails (cellular/CGNAT, strict firewalls).
# Leave empty to disable. Example: turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349
APP_WEBRTC_TURN_URLS=
APP_WEBRTC_TURN_USERNAME=
# Placeholder only - never commit a real TURN credential.
APP_WEBRTC_TURN_CREDENTIAL=

# --- Accounts and login (step 3) ---
# Secret used to sign login tokens (JWT, HS256). Must be at least 32 bytes. Use a long random value in any shared
# or deployed environment, e.g. generate one with: openssl rand -base64 48
# If left empty the server still starts, but generates a random secret for that run and logs a WARNING:
# every restart then logs everybody out. Placeholder only - never commit a real secret.
APP_JWT_SECRET=
# How long a login token stays valid (ISO-8601 duration, e.g. PT12H = 12 hours, P7D = 7 days).
APP_JWT_TTL=PT12H

# --- Donations via Toss Payments, TEST mode only (step 4) ---
# Get test keys for free at https://developers.tosspayments.com (sign up -> "API 키" menu -> use the TEST keys of the
# "주문서형, 결제창형 연동 키" set: client key test_gck_..., secret key test_gsk_...). No business registration needed.
# Both are optional: without them the server still starts, GET /api/payments/config says {"enabled":false} and the
# donation endpoints answer 503. Placeholders only - never commit real keys, and never put the secret key in the frontend.
# Client key: public by design, handed to the browser to open the payment window.
# Example format: test_gck_xxxxxxxxxxxxxxxxxxxx
TOSS_CLIENT_KEY=
# Secret key: server only (payment approval). Keys that do not start with "test_" are refused (see TOSS_ALLOW_LIVE_KEYS).
# Example format: test_gsk_xxxxxxxxxxxxxxxxxxxx
TOSS_SECRET_KEY=
# Toss API base URL (the default is the real Toss server; test keys use the same URL and move no real money).
TOSS_API_BASE_URL=https://api.tosspayments.com
# Set true to accept Toss's payment notifications (webhook) at POST /api/payments/toss/webhook. Needs a public HTTPS
# URL (e.g. a tunnel) registered in the Toss developer center; the handler re-fetches every payment from Toss.
TOSS_WEBHOOK_ENABLED=false
# This assignment is test-mode only. Leave false; true would allow live_ keys (real money). Do not.
TOSS_ALLOW_LIVE_KEYS=false
# Where Toss sends the browser after the payment window: <base>/donations/success and <base>/donations/fail.
# Must be the address you open the frontend on.
APP_FRONTEND_BASE_URL=http://localhost:5173
