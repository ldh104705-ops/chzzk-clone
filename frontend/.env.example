# Base URL of the backend API, without a trailing slash.
# Leave empty to use the same origin (local dev: Vite proxies /api to http://localhost:8080).
# For a separately hosted frontend (e.g. Cloudflare Pages) set the backend URL, e.g.
#   VITE_API_BASE_URL=https://your-backend.up.railway.app
# The backend must then list this site's origin in APP_CORS_ALLOWED_ORIGINS.
VITE_API_BASE_URL=

# --- Phone testing in development (step 2) ---
# Phone browsers only allow camera/microphone on HTTPS. `npm run dev:https` sets this for you:
# it serves the dev server with a self-signed certificate (the browser shows a warning you must accept).
# The dev server also listens on the LAN, so the phone opens https://<PC LAN IP>:5173 and Vite proxies /api and /ws
# to the backend on localhost:8080 (the backend itself needs no TLS).
VITE_DEV_HTTPS=false
# Extra hostnames the dev server accepts (comma-separated), e.g. a cloudflared tunnel host:
#   VITE_ALLOWED_HOSTS=random-words.trycloudflare.com
VITE_ALLOWED_HOSTS=
