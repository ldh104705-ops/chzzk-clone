# Base URL of the backend API, without a trailing slash.
# Leave empty to use the same origin (local dev: Vite proxies /api to http://localhost:8080).
# For a separately hosted frontend (e.g. Cloudflare Pages) set the backend URL, e.g.
#   VITE_API_BASE_URL=https://your-backend.up.railway.app
# The backend must then list this site's origin in APP_CORS_ALLOWED_ORIGINS.
VITE_API_BASE_URL=
